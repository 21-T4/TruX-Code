# Vertex AI uses Cloud Run Application Default Credentials, not a Gemini API key.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global

# Firebase Web App settings (public client configuration).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_APP_ID=your-firebase-web-app-id

# Optional locally; Cloud Run supplies PORT automatically.
PORT=8080
