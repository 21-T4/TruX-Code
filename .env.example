# Loaded directly by Node.js at startup; Cloud Run does not need Firebase env vars configured separately.
# This is the same Firebase project used by TruX-AI, so users keep one shared TruX account.
# FIREBASE_* values are public Firebase web-app configuration, not secrets.
# Never put service-account private keys or other server secrets in this file.

# Connectors (MCP), memory and background replies. These are real secrets and are intentionally NOT set in this
# file. Provide them to Cloud Run from Secret Manager (see README, "Connectors, memory and background replies"):
#   MCP_ENCRYPTION_KEY            encrypts saved connector credentials (required for any connector)
#   GOOGLE_OAUTH_CLIENT_ID        Google Workspace connectors (Gmail, Drive, Docs, Sheets, Slides, Calendar, People)
#   GOOGLE_OAUTH_CLIENT_SECRET    same
#   DEVELOPER_KNOWLEDGE_API_KEY   optional shared key so nobody has to paste one for Google Developer Knowledge

PORT=8080
GOOGLE_CLOUD_PROJECT=trux-ai
VERTEX_AI_LOCATION=global
# Optional: Gemini model used by the microphone button (speech to text). Defaults to gemini-3.8-flash.
# TRANSCRIBE_MODEL=gemini-3.8-flash

FIREBASE_API_KEY=AIzaSyAs_GDrzlBaucHfiff0Y6cA8GVHjFTA62Q
FIREBASE_AUTH_DOMAIN=trux-ai.firebaseapp.com
FIREBASE_PROJECT_ID=trux-ai
FIREBASE_STORAGE_BUCKET=trux-ai.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=59313097411
FIREBASE_APP_ID=1:59313097411:web:32e4158bfb733fa7cfb076
FIREBASE_MEASUREMENT_ID=G-C32LC29QHC

APP_ORIGIN=https://trux-code.trux.website
