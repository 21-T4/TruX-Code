# TruX Code reads Google Cloud and Firebase public web settings from config/runtime-config.json.
# Firebase web config is not a service-account credential. Never commit service-account JSON keys.
# Optional: override the browser-origin check if deploying to a different custom domain (no trailing slash).
# APP_ORIGIN=https://trux-code.trux.website
# Cloud Run supplies PORT automatically; this is optional for local use.
PORT=8080
